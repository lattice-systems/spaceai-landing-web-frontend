{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/spaceai-landing-web-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://spaceai-landing-api.fly.dev/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
